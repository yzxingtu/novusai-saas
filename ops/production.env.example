# NovusAI SaaS production compose example environment.
# This file is a template and compose-config validation fixture only. Copy it
# outside the repository, replace every placeholder value, then run production
# compose with both NOVUSAI_PROD_ENV_FILE and --env-file pointing at that copied
# file. Compose interpolation reads --env-file, while service containers read
# NOVUSAI_PROD_ENV_FILE through env_file. The production guard intentionally
# refuses to start services from this example file or from example domains.

NOVUSAI_PROD_ENV_FILE=./ops/production.env.example
NOVUSAI_IMAGE_TAG=change-me-release-tag
BACKEND_HTTP_PORT=18000
FRONTEND_HTTP_PORT=18080

DATABASE_NAME=novusai_saas
DATABASE_USER=novusai
DATABASE_PASSWORD=change-me-postgres-password
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0

APP_NAME=NovusAI SaaS
APP_VERSION=0.1.0
APP_ENV=production
DEBUG=false
RUN_MIGRATIONS_ON_STARTUP=false
TIMEZONE=Asia/Shanghai
API_V1_PREFIX=/api/v1
APP_INTERNAL_BASE_URL=http://backend-api:8000
CORS_ORIGINS=["https://novusai.example.com"]
PLATFORM_DOMAINS=novusai.example.com

SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]

LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_DIR=logs
LOG_DB_TO_CONSOLE=false
LOG_QUIET_WEBSOCKET_HANDSHAKE=true

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
RECYCLE_BIN_MODULE_RETENTION_DAYS=30
RECYCLE_BIN_GLOBAL_RETENTION_DAYS=30

AI_CACHE_TTL=3600

ALLOW_CUSTOM_DOMAIN=false
TENANT_DOMAIN_SUFFIX=.example.com
DOMAIN_VERIFICATION_PREFIX=_novusai-verify
SSL_AUTO_RENEW_DAYS=30
SSL_PRIVATE_KEY_ENCRYPTION_KEY=
ACME_USE_STAGING=false
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
ACME_STAGING_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_ACCOUNT_EMAIL=ops@example.com

PLUGIN_REGISTRY_URL=
PLUGIN_REGISTRY_MIRROR=github
PLUGIN_REGISTRY_CACHE_TTL=3600
GITHUB_TOKEN=
GITHUB_PROXY=
GITEE_TOKEN=
PLUGIN_MAX_PACKAGE_SIZE=52428800
PLUGIN_MAX_UNCOMPRESSED_SIZE=209715200
PLUGIN_MAX_ARCHIVE_FILES=2000
PLUGIN_MAX_ARCHIVE_SINGLE_FILE_SIZE=52428800
PLUGIN_MAX_COMPRESSION_RATIO=100
PLUGIN_ASSETS_ENABLED_ONLY=true

FRONTEND_VITE_APP_TITLE=NovusAI SaaS
FRONTEND_VITE_GLOB_API_URL=https://api.novusai.example.com
FRONTEND_VITE_PLATFORM_DOMAINS=novusai.example.com
FRONTEND_VITE_APP_NAMESPACE=novusai-web-saas
FRONTEND_VITE_APP_STORE_SECURE_KEY=change-me-before-production
