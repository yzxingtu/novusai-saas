# ============================================
# NovusAI SaaS Backend Environment Variables
# ============================================
# Copy this file to .env and modify the values

# ============================================
# Application Settings
# ============================================
APP_NAME=NovusAI SaaS
APP_VERSION=0.1.0
APP_ENV=development  # development, staging, production
DEBUG=true

# Timezone (used for backend logic and database)
# Examples: Asia/Shanghai, UTC, America/New_York
TIMEZONE=Asia/Shanghai

# API Settings
API_V1_PREFIX=/api/v1
APP_INTERNAL_BASE_URL=http://127.0.0.1:8000
# Allowed frontend origins for direct browser-to-backend calls.
# Supports JSON array or comma-separated values.
# Examples:
#   CORS_ORIGINS=["http://localhost:5666","http://192.168.31.129:5666"]
#   CORS_ORIGINS=http://localhost:5666,http://192.168.31.129:5666
CORS_ORIGINS=["http://localhost:5666"]

# ============================================
# Security Settings
# ============================================
# IMPORTANT: Generate a secure secret key for production
# You can use: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# JWT Token Settings
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Dev-only bootstrap auth for local E2E:
# - Never use a perpetual JWT; keep the bootstrap secret long-lived and mint normal short-lived tokens instead
# - Only enable in local development, never in staging/production
# - Keep real values in local backend/.env only, never commit them
DEV_BOOTSTRAP_AUTH_ENABLED=false
DEV_BOOTSTRAP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,.local
DEV_ADMIN_BOOTSTRAP_SECRET=
DEV_ADMIN_BOOTSTRAP_USERNAME=
DEV_TENANT_BOOTSTRAP_SECRET=
DEV_TENANT_BOOTSTRAP_USERNAME=
DEV_TENANT_BOOTSTRAP_TENANT_CODE=
DEV_TENANT_USER_BOOTSTRAP_SECRET=

# ============================================
# Database Settings (PostgreSQL)
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=novusai_saas

# Connection Pool
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ============================================
# Redis Settings
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Celery Settings
# ============================================
# Leave empty to use Redis URL
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ============================================
# Logging Settings
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_DIR=logs

# ============================================
# Pagination Settings
# ============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================
# Celery Worker Settings
# ============================================
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]

# ============================================
# AI Settings
# ============================================
AI_CACHE_TTL=3600

# ============================================
# Custom Domain & SSL Settings
# ============================================
# Platform admin domains used for platform-vs-tenant host detection.
# Use hostnames only, without scheme or port.
# Example:
#   PLATFORM_DOMAINS=localhost,127.0.0.1,192.168.31.129
PLATFORM_DOMAINS=localhost,127.0.0.1
ALLOW_CUSTOM_DOMAIN=false
TENANT_DOMAIN_SUFFIX=.example.com
DOMAIN_VERIFICATION_PREFIX=_novusai-verify
SSL_AUTO_RENEW_DAYS=30
SSL_PRIVATE_KEY_ENCRYPTION_KEY=

# ACME (Let's Encrypt) Settings
ACME_USE_STAGING=true
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
ACME_STAGING_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_ACCOUNT_EMAIL=

# ============================================
# Plugin Marketplace Settings
# ============================================
# PLUGIN_REGISTRY_URL, GITHUB_TOKEN, GITHUB_PROXY, GITEE_TOKEN: 预留 / Reserved for future plugin marketplace
PLUGIN_REGISTRY_URL=
PLUGIN_REGISTRY_MIRROR=github
PLUGIN_REGISTRY_CACHE_TTL=3600
GITHUB_TOKEN=
GITHUB_PROXY=
GITEE_TOKEN=

# Plugin Security Limits
PLUGIN_MAX_PACKAGE_SIZE=52428800
PLUGIN_MAX_UNCOMPRESSED_SIZE=209715200
PLUGIN_MAX_ARCHIVE_FILES=2000
PLUGIN_MAX_ARCHIVE_SINGLE_FILE_SIZE=52428800
PLUGIN_MAX_COMPRESSION_RATIO=100
PLUGIN_ASSETS_ENABLED_ONLY=true
