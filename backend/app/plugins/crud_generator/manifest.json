{
  "name": "crud-generator",
  "display_name": "CRUD 代码生成器",
  "version": "1.0.0",
  "description": "可视化 CRUD 代码生成器，支持 CLI、AI 助手和 Alembic 迁移。从数据模型定义生成完整的前后端 CRUD 代码。",
  "author": "NovusAI",
  "type": "api",
  "min_platform_version": "1.0.0",
  "tags": ["dev-tools", "code-generator", "crud"],
  "permissions": ["api_route"],
  "entry_point": "plugin.CrudGeneratorPlugin",
  "dependencies": {},
  "frontend": {
    "routes": [
      {
        "name": "AdminDevCrudGenerator",
        "path": "/admin/dev/crud-generator",
        "component": "views/index.vue",
        "meta": {
          "icon": "lucide:wand-2",
          "title": "admin.dev.crudGenerator.title",
          "authority": ["super"]
        }
      },
      {
        "name": "AdminDevCrudRecords",
        "path": "/admin/dev/crud-records",
        "component": "views/records/index.vue",
        "meta": {
          "icon": "lucide:history",
          "title": "admin.dev.crudGenerator.records.title",
          "authority": ["super"]
        }
      }
    ],
    "menus": [
      {
        "name": "admin.dev.title",
        "code": "PluginDevTools",
        "path": "/dev",
        "icon": "lucide:wrench",
        "sort_order": 100,
        "children": [
          {
            "name": "admin.dev.crudGenerator.title",
            "code": "AdminDevCrudGenerator",
            "path": "/dev/crud-generator",
            "component": "index",
            "icon": "lucide:wand-2",
            "sort_order": 10
          },
          {
            "name": "admin.dev.crudGenerator.records.title",
            "code": "AdminDevCrudRecords",
            "path": "/dev/crud-records",
            "component": "records/index",
            "icon": "lucide:history",
            "sort_order": 11
          }
        ]
      }
    ],
    "locales": {}
  }
}
