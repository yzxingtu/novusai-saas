{# ============================================================
   Jinja2 Template: 前端列表页 index.vue (标准布局)
   生成路径: views/{{ scope_dir }}/{{ parent_menu }}/{{ module | pluralize }}/index.vue

   变量:
     - config: CrudConfig
     - model_class: PascalCase
     - module: kebab-case
     - module_snake: snake_case
     - scope / scope_dir: admin | tenant
     - fields: list[FieldConfig]
     - enums: list[EnumDefinition]
     - has_status_toggle: bool
     - recyclable: bool
     - i18n_prefix: str
     - permissions: PermissionConfig | None
     - parent_menu: str
   ============================================================ #}
{% raw %}<script lang="ts" setup>{% endraw %}

/**
 * {{ scope_dir }}端{{ display_name }}管理列表页面
 */
import type { {{ model_class }}Item } from '#/api/{{ scope_dir }}/{{ module | pluralize }}';

defineOptions({ name: '{{ scope_dir | capitalize }}{{ model_class }}List' });

import { Page } from '@vben/common-ui';
{% set ns = namespace(has_tag=false, has_switch=false) %}
{% for field in fields %}
{% if field.list_render and field.list_render.value == 'tag' %}{% set ns.has_tag = true %}{% endif %}
{% if field.list_render and field.list_render.value == 'switch' %}{% set ns.has_switch = true %}{% endif %}
{% endfor %}
{% if has_status_toggle %}{% set ns.has_switch = true %}{% endif %}

import { Card{% if ns.has_tag %}, Tag{% endif %}{% if ns.has_switch %}, Switch{% endif %} } from 'ant-design-vue';

import { useCrudPage } from '#/adapter/vxe-table';
import {
  delete{{ model_class }}Api,
  get{{ model_class }}ListApi,
{% if has_status_toggle %}
  toggle{{ model_class }}StatusApi,
{% endif %}
} from '#/api/{{ scope_dir }}/{{ module | pluralize }}';
import { $t } from '#/locales';

import {
{% for enum in enums %}
{% for field in fields %}
{% if field.enum_ref == enum.name and field.in_list and field.list_render and field.list_render.value == 'tag' %}
  get{{ enum.name }}Color,
  get{{ enum.name }}Text,
{% endif %}
{% endfor %}
{% endfor %}
  useColumns,
  useGridFormSchema,
} from './data';
import {{ model_class }}Form from './modules/form.vue';

const { Grid, FormDrawer, onRefresh } = useCrudPage<{{ model_class }}Item>({
  api: {
    list: get{{ model_class }}ListApi,
    delete: delete{{ model_class }}Api,
    resource: '/{{ scope_dir }}/{{ parent_menu }}/{{ module | pluralize }}',
  },
  columns: useColumns,
  searchSchema: useGridFormSchema(),
  formComponent: {{ model_class }}Form,
  i18nPrefix: '{{ i18n_prefix }}',
  nameField: '{{ fields[0].name if fields else 'name' }}',
  defaultSort: '{{ config.list_config.default_sort }}',
{% if recyclable %}
  recycleBin: true,
{% endif %}
});
{% if has_status_toggle %}

async function handleToggleStatus(row: {{ model_class }}Item) {
  await toggle{{ model_class }}StatusApi(row.id);
  onRefresh();
}
{% endif %}
{% raw %}</script>{% endraw %}

{% raw %}<template>{% endraw %}

  <Page auto-content-height content-class="flex flex-col gap-4">
    <FormDrawer />
    <Card class="flex-1" :body-style="{ padding: '16px', height: '100%' }">
      <Grid>
{% for field in fields %}
{% if field.in_list and field.list_render %}
{% if field.list_render.value == 'tag' and field.enum_ref %}
        {% raw %}<!-- {% endraw %}{{ field.label_zh }}{% raw %}列 -->{% endraw %}

        {% raw %}<template #{% endraw %}{{ field.name }}_cell="{ row }">
          <Tag :color="get{{ field.enum_ref }}Color(row.{{ field.name }})">
            {% raw %}{{ {% endraw %}get{{ field.enum_ref }}Text(row.{{ field.name }}){% raw %} }}{% endraw %}

          </Tag>
        {% raw %}</template>{% endraw %}

{% endif %}
{% endif %}
{% endfor %}
{% if has_status_toggle %}
        {% raw %}<!-- 状态开关 -->{% endraw %}

        {% raw %}<template #is_active_cell="{ row }">{% endraw %}

          <Switch
            :checked="row.is_active"
            size="small"
            @change="handleToggleStatus(row)"
          />
        {% raw %}</template>{% endraw %}

{% endif %}
      </Grid>
    </Card>
  </Page>
{% raw %}</template>{% endraw %}
