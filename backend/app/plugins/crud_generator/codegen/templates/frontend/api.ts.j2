{# ============================================================
   Jinja2 Template: 前端 API 文件
   生成路径: api/{{ scope_dir }}/{{ module | pluralize }}.ts

   变量:
     - config: CrudConfig
     - model_class: PascalCase 模型类名
     - module: kebab-case 模块名
     - module_snake: snake_case 模块名
     - scope: admin | tenant
     - scope_dir: admin | tenant
     - fields: list[FieldConfig]
     - relations: list[RelationConfig]
     - parent_menu: str
     - has_status_toggle: bool
     - selectable: SelectableConfig | None
   ============================================================ #}
/**
 * {{ scope_dir }}端{{ display_name }}管理 API
 * 对接后端 /{{ scope_dir }}/{{ parent_menu }}/{{ module | pluralize }}/* 接口
 */
import type { ApiRequestOptions } from '#/utils/request';

import { requestClient } from '#/utils/request';

// ============================================================
// 类型定义
// ============================================================

/** {{ display_name }}列表项 */
export interface {{ model_class }}Item {
  id: number;
{% if scope == 'tenant' %}
  tenant_id: number;
{% endif %}
{% for field in fields %}
{% if field.in_list %}
{% if field.type.value in ('string', 'text', 'enum') %}
  {{ field.name }}: string{{ ' | null' if not field.required else '' }};
{% elif field.type.value == 'integer' %}
  {{ field.name }}: number{{ ' | null' if not field.required else '' }};
{% elif field.type.value in ('float', 'decimal') %}
  {{ field.name }}: number{{ ' | null' if not field.required else '' }};
{% elif field.type.value == 'boolean' %}
  {{ field.name }}: boolean;
{% elif field.type.value in ('datetime', 'date') %}
  {{ field.name }}: string{{ ' | null' if not field.required else '' }};
{% elif field.type.value == 'json' %}
  {{ field.name }}: Record<string, unknown> | null;
{% elif field.type.value == 'file' %}
  {{ field.name }}: string | null;
{% endif %}
{% endif %}
{% endfor %}
{% for rel in relations %}
{% if rel.type.value == 'belongs_to' %}
  {{ rel.foreign_key or (rel.name + '_id') }}: number{{ ' | null' if rel.nullable else '' }};
{% endif %}
{% endfor %}
{% if has_status_toggle %}
  is_active: boolean;
{% endif %}
{% if config.drag_sort %}
  sort_order: number;
{% endif %}
  created_at: string;
  updated_at: string;
}

/** 创建{{ display_name }}请求 */
export interface {{ model_class }}CreateRequest {
{% for field in fields %}
{% if field.in_form %}
{% if field.type.value in ('string', 'text', 'enum') %}
  {{ field.name }}{{ '?' if not field.required else '' }}: string{{ ' | null' if not field.required else '' }};
{% elif field.type.value == 'integer' %}
  {{ field.name }}{{ '?' if not field.required else '' }}: number{{ ' | null' if not field.required else '' }};
{% elif field.type.value in ('float', 'decimal') %}
  {{ field.name }}{{ '?' if not field.required else '' }}: number{{ ' | null' if not field.required else '' }};
{% elif field.type.value == 'boolean' %}
  {{ field.name }}?: boolean;
{% elif field.type.value in ('datetime', 'date') %}
  {{ field.name }}?: string | null;
{% elif field.type.value == 'json' %}
  {{ field.name }}?: Record<string, unknown> | null;
{% elif field.type.value == 'file' %}
  {{ field.name }}?: string | null;
{% endif %}
{% endif %}
{% endfor %}
{% for rel in relations %}
{% if rel.type.value == 'belongs_to' %}
  {{ rel.foreign_key or (rel.name + '_id') }}{{ '?' if rel.nullable else '' }}: number{{ ' | null' if rel.nullable else '' }};
{% endif %}
{% endfor %}
{% if has_status_toggle %}
  is_active?: boolean;
{% endif %}
}

/** 更新{{ display_name }}请求 */
export interface {{ model_class }}UpdateRequest {
{% for field in fields %}
{% if field.in_form %}
{% if field.type.value in ('string', 'text', 'enum') %}
  {{ field.name }}?: string | null;
{% elif field.type.value in ('integer', 'float', 'decimal') %}
  {{ field.name }}?: number | null;
{% elif field.type.value == 'boolean' %}
  {{ field.name }}?: boolean | null;
{% elif field.type.value in ('datetime', 'date') %}
  {{ field.name }}?: string | null;
{% elif field.type.value == 'json' %}
  {{ field.name }}?: Record<string, unknown> | null;
{% elif field.type.value == 'file' %}
  {{ field.name }}?: string | null;
{% endif %}
{% endif %}
{% endfor %}
{% for rel in relations %}
{% if rel.type.value == 'belongs_to' %}
  {{ rel.foreign_key or (rel.name + '_id') }}?: number | null;
{% endif %}
{% endfor %}
{% if has_status_toggle %}
  is_active?: boolean | null;
{% endif %}
}

/** 分页响应 */
interface PageResponse<T> {
  items: T[];
  page: number;
  page_size: number;
  total: number;
}

// ============================================================
// API 接口
// ============================================================

const PREFIX = '/{{ scope_dir }}/{{ parent_menu }}/{{ module | pluralize }}';

/** 获取{{ display_name }}列表 */
export async function get{{ model_class }}ListApi(
  params?: Record<string, unknown>,
  options?: ApiRequestOptions,
): Promise<PageResponse<{{ model_class }}Item>> {
  return requestClient.get<PageResponse<{{ model_class }}Item>>(
    PREFIX,
    { params, ...options },
  );
}

/** 获取{{ display_name }}详情 */
export async function get{{ model_class }}DetailApi(
  id: number,
  options?: ApiRequestOptions,
): Promise<{{ model_class }}Item> {
  return requestClient.get<{{ model_class }}Item>(
    `${PREFIX}/${id}`,
    options,
  );
}

/** 创建{{ display_name }} */
export async function create{{ model_class }}Api(
  data: {{ model_class }}CreateRequest,
  options?: ApiRequestOptions,
): Promise<{{ model_class }}Item> {
  return requestClient.post<{{ model_class }}Item>(
    PREFIX,
    data,
    options,
  );
}

/** 更新{{ display_name }} */
export async function update{{ model_class }}Api(
  id: number,
  data: {{ model_class }}UpdateRequest,
  options?: ApiRequestOptions,
): Promise<{{ model_class }}Item> {
  return requestClient.put<{{ model_class }}Item>(
    `${PREFIX}/${id}`,
    data,
    options,
  );
}

/** 删除{{ display_name }} */
export async function delete{{ model_class }}Api(
  id: number,
  options?: ApiRequestOptions,
): Promise<void> {
  await requestClient.delete(`${PREFIX}/${id}`, options);
}
{% if has_status_toggle %}

/** 切换{{ display_name }}状态 */
export async function toggle{{ model_class }}StatusApi(
  id: number,
  options?: ApiRequestOptions,
): Promise<{{ model_class }}Item> {
  return requestClient.put<{{ model_class }}Item>(
    `${PREFIX}/${id}/toggle-status`,
    {},
    options,
  );
}
{% endif %}
{% if selectable %}

/** 获取{{ display_name }}下拉选项 */
export async function get{{ model_class }}SelectApi(
  params?: Record<string, unknown>,
): Promise<Array<{ label: string; value: number }>> {
  return requestClient.get(`${PREFIX}/select`, { params });
}
{% endif %}
