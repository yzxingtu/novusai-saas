{
  "name": "example-weather-tool",
  "display_name": "Weather Tool (Example)",
  "version": "1.0.0",
  "description": "An example ToolPlugin that provides weather lookup for AI agents. Demonstrates tool definition, execution, and configuration schema.",
  "author": "NovusAI Team",
  "plugin_type": "tool",
  "scope": "all_tenants",
  "entry_point": "plugin.ExampleWeatherToolPlugin",
  "icon": "lucide:cloud-sun",
  "homepage": "",
  "config_schema": {
    "type": "object",
    "properties": {
      "api_key": {
        "type": "string",
        "title": "Weather API Key",
        "description": "API key for the weather service provider",
        "format": "password"
      },
      "default_unit": {
        "type": "string",
        "title": "Temperature Unit",
        "description": "Default temperature unit for responses",
        "enum": ["celsius", "fahrenheit"],
        "default": "celsius"
      },
      "cache_ttl": {
        "type": "integer",
        "title": "Cache TTL (seconds)",
        "description": "How long to cache weather data",
        "minimum": 60,
        "maximum": 3600,
        "default": 300
      }
    },
    "required": ["api_key"]
  },
  "default_config": {
    "default_unit": "celsius",
    "cache_ttl": 300
  },
  "required_permissions": ["http:outbound"],
  "dependencies": {},
  "conflicts": [],
  "platform_version": null
}
