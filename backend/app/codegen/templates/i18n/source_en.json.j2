{# ============================================================
   Jinja2 Template: Frontend English i18n JSON
   Generated path: locales/langs/en-US/{{ scope_dir }}/{{ module_snake }}.json

   English counterpart of source_zh.json.j2.
   Uses display_name_en and label_en fields.

   Variables:
     - config: CrudConfig
     - model_class: PascalCase
     - module_snake: snake_case
     - scope / scope_dir: admin | tenant
     - fields: list[FieldConfig]
     - enums: list[EnumDefinition]
     - display_name_en: str
     - has_status_toggle: bool
     - permissions: PermissionConfig | None
   ============================================================ #}
{
  "title": "{{ display_name_en }} Management",
  "pageDesc": "Manage {{ display_name_en }} data, including create, edit, and delete operations.",
  "create": "Create {{ display_name_en }}",
  "edit": "Edit {{ display_name_en }}",
  "detail": "{{ display_name_en }} Details",
  "search": "Search {{ display_name_en }}",
  "selectToView": "Select a record to view details",
  "confirmDelete": "Are you sure you want to delete this {{ display_name_en }}?",
  "field": {
{% for field in fields %}
    "{{ field.name }}": "{{ field.label_en }}"{{ ',' if not loop.last or has_status_toggle or config.drag_sort }}
{% endfor %}
{% if has_status_toggle %}
    "isActive": "Active"{{ ',' if config.drag_sort }}
{% endif %}
{% if config.drag_sort %}
    "sortOrder": "Sort Order"
{% endif %}
  },
  "placeholder": {
{% set ph = namespace(items=[]) %}
{% for field in fields %}
{% if field.searchable %}
{% set ph.items = ph.items + ['"search' + (field.name | capitalize) + '": "Search ' + field.label_en + '"'] %}
{% elif field.in_form %}
{% if field.type.value in ('string', 'text') %}
{% set ph.items = ph.items + ['"input' + (field.name | capitalize) + '": "Enter ' + field.label_en + '"'] %}
{% elif field.type.value in ('enum',) or field.form_component.value == 'Select' %}
{% set ph.items = ph.items + ['"select' + (field.name | capitalize) + '": "Select ' + field.label_en + '"'] %}
{% endif %}
{% endif %}
{% endfor %}
{% for item in ph.items %}
    {{ item }}{{ ',' if not loop.last }}
{% endfor %}
  },
{% if enums %}
  "enum": {
{% for enum in enums %}
    "{{ enum.name | snake }}": {
{% for opt in enum.values %}
      "{{ opt.value }}": "{{ opt.label_en }}"{{ ',' if not loop.last }}
{% endfor %}
    }{{ ',' if not loop.last }}
{% endfor %}
  },
{% endif %}
  "messages": {
    "createSuccess": "{{ display_name_en }} created successfully",
    "updateSuccess": "{{ display_name_en }} updated successfully",
    "deleteSuccess": "{{ display_name_en }} deleted"
{% if has_status_toggle %}
    ,"toggleStatusSuccess": "Status toggled successfully"
{% endif %}
  }
}
