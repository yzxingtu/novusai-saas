    async def {{ f.name }}_exists(self, {{ f.name }}: {{ type_registry.get_type_info(f.type | default('String')).python_type }}, exclude_id: int | None = None) -> bool:
        """检查{{ f.name }}是否已存在 / Check if {{ f.name }} exists."""
        query = select(self.model.id).where(self.model.{{ f.name }} == {{ f.name }}, self.model.is_deleted.is_(False))
