{# 主仓储：场景 A/B 用 BaseRepository，C 用 TenantRepository，D 用 TenantRepository（企业端） #}
class {{ resource | pascal }}Repository({{ 'TenantRepository' if use_tenant_repo else 'BaseRepository' }}[{{ resource | pascal }}]):
    """
    {{ display_name }}仓储 / {{ display_name_en }} repository.
    """

    model = {{ resource | pascal }}

{% for f in unique_fields %}
    async def get_by_{{ f.name }}(self, {{ f.name }}: {{ type_registry.get_type_info(f.type | default('String')).python_type }}) -> {{ resource | pascal }} | None:
        """
        根据{{ f.name }}获取 / Get by {{ f.name }}.

        Args:
            {{ f.name }}: {{ f.comment | default(f.name) }}

        Returns:
            实例或 None / Instance or None
        """
        return await self.get_one_by({{ f.name }}={{ f.name }}{% if use_tenant_repo %}, tenant_id=self.tenant_id{% endif %})

    async def {{ f.name }}_exists(
        self,
        {{ f.name }}: {{ type_registry.get_type_info(f.type | default('String')).python_type }},
        exclude_id: int | None = None,
    ) -> bool:
        """
        检查{{ f.name }}是否已存在 / Check if {{ f.name }} exists.

        Args:
            {{ f.name }}: {{ f.comment | default(f.name) }}
            exclude_id: 排除的 ID（更新时排除自身）/ Exclude ID (for update)

        Returns:
            是否存在 / Whether exists
        """
        query = select(self.model.id).where(
            self.model.{{ f.name }} == {{ f.name }},
            self.model.is_deleted.is_(False),
        )
{% if use_tenant_repo %}
        query = query.where(self.model.tenant_id == self.tenant_id)
{% endif %}
        if exclude_id:
            query = query.where(self.model.id != exclude_id)

        result = await self.db.execute(query)
        return result.scalar_one_or_none() is not None

{% endfor %}
{% if has_tree %}
    async def get_tree(self, parent_id: int | None = None) -> list[{{ resource | pascal }}]:
        """
        获取树形结构 / Get tree structure.

        Args:
            parent_id: 父节点 ID，None 表示根节点 / Parent ID, None for root

        Returns:
            树形节点列表 / Tree node list
        """
        query = select(self.model).where(
            self.model.parent_id == parent_id,
            self.model.is_deleted.is_(False),
        )
{% if use_tenant_repo %}
        query = query.where(self.model.tenant_id == self.tenant_id)
{% endif %}
        query = query.order_by(self.model.sort_order.asc() if hasattr(self.model, 'sort_order') else self.model.id.asc())
        result = await self.db.execute(query)
        return list(result.scalars().all())

{% endif %}
{% if need_selectinload %}
    async def get_with_relations(self, id: int) -> {{ resource | pascal }} | None:
        """
        获取含关联数据的记录 / Get record with relations.

        Args:
            id: 记录 ID / Record ID

        Returns:
            实例（含关联）或 None / Instance with relations or None
        """
        query = select(self.model)
{% for r in fk_relations %}
{% set rel_name = r.name | default((r.foreign_key | default(r.target | model_to_fk)) | replace('_id', '')) %}
        query = query.options(selectinload(self.model.{{ rel_name }}))
{% endfor %}
{% for r in m2m_relations %}
        query = query.options(selectinload(self.model.{{ r.name }}))
{% endfor %}
        query = query.where(
            self.model.id == id,
            self.model.is_deleted.is_(False),
        )
{% if use_tenant_repo %}
        query = query.where(self.model.tenant_id == self.tenant_id)
{% endif %}
        result = await self.db.execute(query)
        return result.scalar_one_or_none()

{% endif %}

