{# ============================================================
   Jinja2 Template: Controller (Tenant + Admin)
   生成路径:
     scope=tenant → app/api/tenant/{{ module_snake }}.py
     scope=admin  → app/api/admin/{{ module_snake }}.py
     scope=both   → 同时生成两个文件

   变量:
     - config: CrudConfig
     - model_class: PascalCase 模型类名
     - module: kebab-case 模块名
     - module_snake: snake_case 模块名
     - scope: admin | tenant  (当前渲染的 scope)
     - scope_dir: admin | tenant
     - display_name: str
     - table_name: snake_case 表名
     - fields: list[FieldConfig]
     - relations: list[RelationConfig]
     - permissions: PermissionConfig | None
     - recyclable: bool
     - has_status_toggle: bool
     - selectable: SelectableConfig | None
     - parent_menu: str
   ============================================================ #}
{% set resource_code = permissions.resource_code if permissions and permissions.resource_code else module_snake %}
{% set menu_icon = permissions.menu_icon if permissions else 'lucide:file-text' %}
{% set menu_sort = permissions.menu_sort_order if permissions else 10 %}
"""
{% if scope == 'tenant' %}
租户端{{ display_name }}管理 API
{% else %}
平台端{{ display_name }}管理 API
{% endif %}
"""

from fastapi import Request

{% if scope == 'tenant' %}
from app.core.base_controller import TenantController
from app.core.deps import DbSession, ActiveTenantAdmin, QueryParams
{% else %}
from app.core.base_controller import GlobalController
from app.core.deps import DbSession, ActiveAdmin, QueryParams
{% endif %}
from app.core.i18n import _
from app.core.response import success, created, deleted, paginated
from app.enums.rbac import PermissionScope
from app.exceptions import NotFoundException
from app.rbac.decorators import (
    permission_resource,
    MenuConfig,
    action_read,
    action_create,
    action_update,
    action_delete,
)
{% if scope == 'tenant' %}
from app.schemas.{{ scope_dir }}.{{ module_snake }} import {{ model_class }}Create, {{ model_class }}Update
from app.services.{{ scope_dir }}.{{ module_snake }}_service import {{ model_class }}Service
{% if recyclable %}
from app.core.recycle_bin import register_tenant_recycle_bin_routes
{% endif %}
{% else %}
from app.schemas.{{ scope_dir }}.{{ module_snake }} import {{ model_class }}Create, {{ model_class }}Update
from app.services.{{ scope_dir }}.{{ module_snake }}_service import Admin{{ model_class }}Service
{% if recyclable %}
from app.core.recycle_bin import register_admin_recycle_bin_routes
{% endif %}
{% endif %}


def _serialize(item) -> dict:
    """从 ORM 对象构建列表项字典"""
    return {
        "id": item.id,
{% if scope == 'tenant' %}
        "tenant_id": item.tenant_id,
{% endif %}
{% for field in fields %}
{% if field.in_list %}
        "{{ field.name }}": item.{{ field.name }},
{% endif %}
{% endfor %}
{% for rel in relations %}
{% if rel.type.value == 'belongs_to' %}
        "{{ rel.foreign_key or (rel.name + '_id') }}": item.{{ rel.foreign_key or (rel.name + '_id') }},
{% endif %}
{% endfor %}
{% if has_status_toggle %}
        "is_active": item.is_active,
{% endif %}
{% if config.drag_sort %}
        "sort_order": item.sort_order,
{% endif %}
        "created_at": item.created_at,
        "updated_at": item.updated_at,
    }


{% if scope == 'tenant' %}
@permission_resource(
    resource="{{ resource_code }}",
    name="menu.tenant.{{ module_snake }}",
    scope=PermissionScope.TENANT,
    menu=MenuConfig(
        icon="{{ menu_icon }}",
        path="/{{ parent_menu }}/{{ module }}s",
        component="tenant/{{ parent_menu }}/{{ module }}s/index",
        parent="{{ parent_menu }}",
        sort_order={{ menu_sort }},
    ),
)
class Tenant{{ model_class }}Controller(TenantController):
    """租户{{ display_name }}管理控制器"""

    prefix = "/{{ parent_menu }}/{{ module }}s"
    tags = [_("menu.tags.tenant_{{ module_snake }}_mgmt")]

    def _register_routes(self) -> None:
        router = self.router
{% if recyclable %}

        # 回收站路由必须在 /{id} 之前注册
        register_tenant_recycle_bin_routes(
            router=router,
            service_class={{ model_class }}Service,
            resource_name="{{ module_snake }}",
            serialize=_serialize,
        )
{% endif %}

        @router.get("", summary="获取{{ display_name }}列表")
        @action_read("action.{{ resource_code }}.list")
        async def list_items(
            request: Request,
            db: DbSession,
            tenant_admin: ActiveTenantAdmin,
            query: QueryParams,
        ):
            service = {{ model_class }}Service(db, tenant_admin.tenant_id)
            items, total = await service.query_list(spec=query)
            return paginated(
                items=[_serialize(item) for item in items],
                total=total,
                page=query.page,
                page_size=query.size,
            )

        @router.get("/{id}", summary="获取{{ display_name }}详情")
        @action_read("action.{{ resource_code }}.detail")
        async def get_item(
            id: int,
            db: DbSession,
            tenant_admin: ActiveTenantAdmin,
        ):
            service = {{ model_class }}Service(db, tenant_admin.tenant_id)
            item = await service.get_by_id(id)
            if not item:
                raise NotFoundException(message=_("{{ module_snake }}.error.not_found"))
            return success(data=_serialize(item))

        @router.post("", summary="创建{{ display_name }}")
        @action_create("action.{{ resource_code }}.create")
        async def create_item(
            request: Request,
            db: DbSession,
            tenant_admin: ActiveTenantAdmin,
            body: {{ model_class }}Create,
        ):
            service = {{ model_class }}Service(db, tenant_admin.tenant_id)
            item = await service.create(body.model_dump(exclude_unset=True))
            return created(data=_serialize(item))

        @router.put("/{id}", summary="更新{{ display_name }}")
        @action_update("action.{{ resource_code }}.update")
        async def update_item(
            id: int,
            db: DbSession,
            tenant_admin: ActiveTenantAdmin,
            body: {{ model_class }}Update,
        ):
            service = {{ model_class }}Service(db, tenant_admin.tenant_id)
            item = await service.update(id, body.model_dump(exclude_unset=True))
            if not item:
                raise NotFoundException(message=_("{{ module_snake }}.error.not_found"))
            return success(data=_serialize(item))

        @router.delete("/{id}", summary="删除{{ display_name }}")
        @action_delete("action.{{ resource_code }}.delete")
        async def delete_item(
            id: int,
            db: DbSession,
            tenant_admin: ActiveTenantAdmin,
        ):
            service = {{ model_class }}Service(db, tenant_admin.tenant_id)
            await service.delete(id)
            return deleted()
{% if has_status_toggle %}

        @router.put("/{id}/toggle-status", summary="切换{{ display_name }}状态")
        @action_update("action.{{ resource_code }}.toggle_status")
        async def toggle_status(
            id: int,
            db: DbSession,
            tenant_admin: ActiveTenantAdmin,
        ):
            service = {{ model_class }}Service(db, tenant_admin.tenant_id)
            item = await service.get_by_id(id)
            if not item:
                raise NotFoundException(message=_("{{ module_snake }}.error.not_found"))
            item = await service.update(id, {"is_active": not item.is_active})
            return success(data=_serialize(item))
{% endif %}
{% if selectable %}

        @router.get("/select", summary="获取{{ display_name }}下拉选项")
        @action_read("action.{{ resource_code }}.select")
        async def get_select_options(
            db: DbSession,
            tenant_admin: ActiveTenantAdmin,
            query: QueryParams,
        ):
            service = {{ model_class }}Service(db, tenant_admin.tenant_id)
            items = await service.get_select_options(query)
            return success(data=items)
{% endif %}
{% else %}
@permission_resource(
    resource="admin_{{ resource_code }}",
    name="menu.admin.{{ module_snake }}",
    scope=PermissionScope.ADMIN,
    menu=MenuConfig(
        icon="{{ menu_icon }}",
        path="/{{ parent_menu }}/{{ module }}s",
        component="admin/{{ parent_menu }}/{{ module }}s/index",
        parent="{{ parent_menu }}",
        sort_order={{ menu_sort }},
    ),
)
class Admin{{ model_class }}Controller(GlobalController):
    """平台{{ display_name }}管理控制器"""

    prefix = "/{{ parent_menu }}/{{ module }}s"
    tags = [_("menu.tags.admin_{{ module_snake }}_mgmt")]

    def _register_routes(self) -> None:
        router = self.router
{% if recyclable %}

        # 回收站路由
        register_admin_recycle_bin_routes(
            router=router,
            service_class=Admin{{ model_class }}Service,
            resource_name="admin_{{ module_snake }}",
            serialize=_serialize,
        )
{% endif %}

        @router.get("", summary="全局{{ display_name }}列表")
        @action_read("action.admin_{{ resource_code }}.list")
        async def list_items(
            request: Request,
            db: DbSession,
            admin: ActiveAdmin,
            query: QueryParams,
        ):
            service = Admin{{ model_class }}Service(db)
            items, total = await service.query_list(spec=query)
            return paginated(
                items=[_serialize(item) for item in items],
                total=total,
                page=query.page,
                page_size=query.size,
            )

        @router.get("/{id}", summary="获取{{ display_name }}详情")
        @action_read("action.admin_{{ resource_code }}.detail")
        async def get_item(
            id: int,
            db: DbSession,
            admin: ActiveAdmin,
        ):
            service = Admin{{ model_class }}Service(db)
            item = await service.get_by_id(id)
            if not item:
                raise NotFoundException(message=_("{{ module_snake }}.error.not_found"))
            return success(data=_serialize(item))

        @router.post("", summary="创建{{ display_name }}")
        @action_create("action.admin_{{ resource_code }}.create")
        async def create_item(
            request: Request,
            db: DbSession,
            admin: ActiveAdmin,
            body: {{ model_class }}Create,
        ):
            service = Admin{{ model_class }}Service(db)
            item = await service.create(body.model_dump(exclude_unset=True))
            return created(data=_serialize(item))

        @router.put("/{id}", summary="更新{{ display_name }}")
        @action_update("action.admin_{{ resource_code }}.update")
        async def update_item(
            id: int,
            db: DbSession,
            admin: ActiveAdmin,
            body: {{ model_class }}Update,
        ):
            service = Admin{{ model_class }}Service(db)
            item = await service.update(id, body.model_dump(exclude_unset=True))
            if not item:
                raise NotFoundException(message=_("{{ module_snake }}.error.not_found"))
            return success(data=_serialize(item))

        @router.delete("/{id}", summary="删除{{ display_name }}")
        @action_delete("action.admin_{{ resource_code }}.delete")
        async def delete_item(
            id: int,
            db: DbSession,
            admin: ActiveAdmin,
        ):
            service = Admin{{ model_class }}Service(db)
            await service.delete(id)
            return deleted()
{% if has_status_toggle %}

        @router.put("/{id}/toggle-status", summary="切换{{ display_name }}状态")
        @action_update("action.admin_{{ resource_code }}.toggle_status")
        async def toggle_status(
            id: int,
            db: DbSession,
            admin: ActiveAdmin,
        ):
            service = Admin{{ model_class }}Service(db)
            item = await service.get_by_id(id)
            if not item:
                raise NotFoundException(message=_("{{ module_snake }}.error.not_found"))
            item = await service.update(id, {"is_active": not item.is_active})
            return success(data=_serialize(item))
{% endif %}
{% endif %}
