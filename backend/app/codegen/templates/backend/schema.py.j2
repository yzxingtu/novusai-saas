{% elif field.type.value == 'json' %}
    {{ field.name }}: {{ 'dict | list' if field.required else 'dict | list | None' }} = Field(
        {{ '...' if field.required else 'None' }},
        description="{{ field.label_zh }}",
    )
{% elif field.type.value == 'enum' %}
    {{ field.name }}: {{ 'str' if field.required else 'str | None' }} = Field(
        {{ '...' if field.required else 'None' }},
        description="{{ field.label_zh }}",
    )
{% elif field.type.value == 'file' %}
{% if field.upload and field.upload.max_count > 1 %}
    {{ field.name }}: list | None = Field(
        None,
        description="{{ field.label_zh }}",
    )
{% else %}
    {{ field.name }}: str | None = Field(
        None,
        description="{{ field.label_zh }}",
    )
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
{% for rel in relations %}
{% if rel.type.value == 'belongs_to' %}
    {{ rel.foreign_key or (rel.name + '_id') }}: {{ 'int' if not rel.nullable else 'int | None' }} = Field(
        {{ '...' if not rel.nullable else 'None' }},
        description="{{ rel.comment_zh or rel.name }}",
    )
{% endif %}
{% endfor %}
{% if config.has_status_toggle %}
    is_active: bool = Field(True, description="是否启用")
{% endif %}
{% if config.drag_sort %}
    sort_order: int = Field(0, description="排序序号")
{% endif %}


