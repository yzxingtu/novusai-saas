    {{ field.name }}: {{ 'float' if field.required else 'float | None' }} = Field(
        {{ '...' if field.required else 'None' }},
        description="{{ field.label_zh }}",
    )
{% elif field.type.value == 'decimal' %}
    {{ field.name }}: {{ 'float' if field.required else 'float | None' }} = Field(
        {{ '...' if field.required else 'None' }},
        description="{{ field.label_zh }}",
    )
{% elif field.type.value == 'boolean' %}
    {{ field.name }}: bool = Field(
        {{ field.default if field.default is not none else 'False' }},
        description="{{ field.label_zh }}",
    )
{% elif field.type.value == 'datetime' %}
    {{ field.name }}: {{ 'datetime' if field.required else 'datetime | None' }} = Field(
        {{ '...' if field.required else 'None' }},
        description="{{ field.label_zh }}",
    )
{% elif field.type.value == 'date' %}
