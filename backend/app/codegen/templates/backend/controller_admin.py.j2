{% if has_batch_import %}
        @router.post("/import", summary=_("action.{{ res_name }}.import"))
        @action_create("action.{{ res_name }}.import")
        async def import_excel(
            request: Request,
            db: DbSession,
            file: UploadFile,
            current_admin: ActiveAdmin,
        ):
            """Import records from Excel. First row = headers (field names). / 从 Excel 导入，首行为列名"""
            from io import BytesIO
            from openpyxl import load_workbook
            service = {{ resource | pascal }}Service(db)
            content = await file.read()
            wb = load_workbook(BytesIO(content), read_only=True)
            ws = wb.active
            if not ws:
                return success(data={"imported": 0, "errors": ["Empty workbook"]}, message=_("common.success"))
            rows = list(ws.iter_rows(values_only=True))
            if len(rows) < 2:
                return success(data={"imported": 0}, message=_("common.success"))
            headers = [str(c).strip() if c is not None else "" for c in rows[0]]
            imported = 0
            errors = []
            for i, row in enumerate(rows[1:], start=2):
                try:
                    vals = list(row) + [None] * max(0, len(headers) - len(row))
                    data = {h: v for h, v in zip(headers, vals) if h}
                    data = {k: v for k, v in data.items() if v is not None and str(v).strip() != ""}
                    if not data:
                        continue
                    validated = {{ resource | pascal }}Create(**data)
                    item = await service.create(validated.model_dump(exclude_none=True))
                    if item:
                        imported += 1
                except Exception as e:
                    errors.append(f"Row {i}: {str(e)}")
            await db.commit()
            return success(data={"imported": imported, "errors": errors[:10]}, message=_("common.success"))

{% endif %}

router = Admin{{ resource | pascal }}Controller.get_router()

