{#
M2M 中间表模板 / M2M Junction Table Template
当多对多关系需独立中间表文件时使用
Use when many-to-many junction should be in a separate file.
#}
"""
{{ display_name }}-{{ (relations | selectattr('type', 'equalto', 'many_to_many') | first | attr('target') if relations else 'Target') }} 多对多中间表
{{ display_name_en }}-Target M2M junction table
"""

from sqlalchemy import Column, ForeignKey, Integer, Table

from app.core.base_model import Base

{% set table_name = model.table_name | default(resource_plural) %}


{% for rel in relations if rel.type == 'many_to_many' %}
{% set target_table = rel.target | model_to_table %}
{% set junc_table_name = rel.junction_table | default(resource + '_' + target_table) %}
{% set my_fk = rel.my_fk | default(resource + '_id') %}
{% set target_fk = rel.target_fk | default(rel.target | model_to_fk) %}
{{ junc_table_name | replace('-', '_') }} = Table(
    "{{ junc_table_name }}",
    Base.metadata,
    Column("{{ my_fk }}", Integer, ForeignKey("{{ table_name }}.id", ondelete="CASCADE"), primary_key=True),
    Column("{{ target_fk }}", Integer, ForeignKey("{{ target_table }}.id", ondelete="CASCADE"), primary_key=True),
)


{% endfor %}
__all__ = [
{% for rel in relations if rel.type == 'many_to_many' %}
{% set junc_name = (rel.junction_table | default(resource + '_' + (rel.target | model_to_table))) | replace('-', '_') %}
    "{{ junc_name }}",
{% endfor %}
]
