{# ============================================================
   Jinja2 Template: 前端看板布局列表页 index_kanban.vue.j2
   生成路径: views/{{ scope_dir }}/{{ parent_menu }}/{{ module }}s/index.vue
   LayoutVariant = kanban
   要求: 至少一个 enum 字段作为看板列（使用第一个 enum 字段）
   ============================================================ #}
{% set kb = namespace(field=none, enum=none) %}
{% for field in fields %}
{% if field.type.value == 'enum' and field.enum_ref and not kb.field %}
{% set kb.field = field %}
{% for e in enums %}
{% if e.name == field.enum_ref %}
{% set kb.enum = e %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% raw %}<script lang="ts" setup>{% endraw %}

/**
 * {{ scope_dir }}端{{ display_name }}管理 — 看板布局
 */
import type { {{ model_class }}Item } from '#/api/{{ scope_dir }}/{{ module }}s';

defineOptions({ name: '{{ scope_dir | capitalize }}{{ model_class }}Kanban' });

import { ref, computed, onMounted } from 'vue';

import { Page } from '@vben/common-ui';
import { Plus } from '@vben/icons';

import { Button, Card, Tag, Badge, Spin } from 'ant-design-vue';

import { get{{ model_class }}ListApi } from '#/api/{{ scope_dir }}/{{ module }}s';
import { $t } from '#/locales';
{% if kb.enum %}

import { get{{ kb.enum.name }}Color, get{{ kb.enum.name }}Text } from './data';
{% endif %}
import {{ model_class }}Form from './modules/form.vue';

const formRef = ref<InstanceType<typeof {{ model_class }}Form>>();
const loading = ref(false);
const allItems = ref<{{ model_class }}Item[]>([]);
{% if kb.enum %}

const columns = [
{% for opt in kb.enum.values %}
  { value: '{{ opt.value }}', label: '{{ opt.label_zh }}', color: '{{ opt.color or "default" }}' },
{% endfor %}
];

const groupedItems = computed(() => {
  const groups: Record<string, {{ model_class }}Item[]> = {};
  for (const col of columns) {
    groups[col.value] = [];
  }
  for (const item of allItems.value) {
    const key = (item as Record<string, unknown>).{{ kb.field.name }} as string;
    if (groups[key]) {
      groups[key].push(item);
    }
  }
  return groups;
});
{% endif %}

async function fetchData() {
  loading.value = true;
  try {
    const res = await get{{ model_class }}ListApi({
      'page[size]': 200,
      sort: '{{ config.list_config.default_sort }}',
    });
    allItems.value = res.items;
  } finally {
    loading.value = false;
  }
}

function onFormSuccess() {
  fetchData();
}

onMounted(() => fetchData());
{% raw %}</script>{% endraw %}

{% raw %}<template>{% endraw %}

  <Page auto-content-height content-class="flex flex-col gap-4">
    <{{ model_class }}Form ref="formRef" @success="onFormSuccess" />

    <div class="mb-4 flex items-center justify-end">
      <Button
        type="primary"
        v-access:code="['{{ module_snake }}:create']"
        @click="formRef?.openNew()"
      >
        <Plus class="mr-1 size-4" />
        {% raw %}{{ {% endraw %}$t('{{ i18n_prefix }}.create'){% raw %} }}{% endraw %}

      </Button>
    </div>

    <Spin :spinning="loading">
{% if kb.enum %}
      <div class="flex gap-4 overflow-x-auto pb-4">
        <div
          v-for="col in columns"
          :key="col.value"
          class="min-w-[280px] flex-1 rounded-lg bg-accent/30 p-3"
        >
          <div class="mb-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <Tag :color="col.color">{% raw %}{{ {% endraw %}col.label{% raw %} }}{% endraw %}</Tag>
              <Badge :count="groupedItems[col.value]?.length || 0" class="ml-1" />
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <Card
              v-for="item in groupedItems[col.value]"
              :key="item.id"
              size="small"
              hoverable
              class="cursor-pointer"
              @click="formRef?.openEdit(item)"
            >
{% for field in fields %}
{% if field.in_list and field != kb.field and loop.index <= 3 %}
{% if loop.index == 1 %}
              <div class="text-sm font-medium">{% raw %}{{ {% endraw %}item.{{ field.name }}{% raw %} }}{% endraw %}</div>
{% else %}
              <div class="text-xs text-muted-foreground">{% raw %}{{ {% endraw %}item.{{ field.name }} || '-'{% raw %} }}{% endraw %}</div>
{% endif %}
{% endif %}
{% endfor %}
            </Card>
          </div>
        </div>
      </div>
{% else %}
      <p>{% raw %}{{ {% endraw %}$t('common.noData'){% raw %} }}{% endraw %}</p>
{% endif %}
    </Spin>
  </Page>
{% raw %}</template>{% endraw %}
