{# ============================================================
   Jinja2 Template: 前端 data.ts (列定义 + 搜索 + 表单 Schema)
   生成路径: views/{{ scope_dir }}/{{ parent_menu }}/{{ module }}s/data.ts

   变量:
     - config: CrudConfig
     - model_class: PascalCase
     - module: kebab-case
     - module_snake: snake_case
     - scope / scope_dir: admin | tenant
     - fields: list[FieldConfig]
     - enums: list[EnumDefinition]
     - search_config: SearchConfig | None
     - has_status_toggle: bool
     - i18n_prefix: str  (如 tenant.order)
   ============================================================ #}
/**
 * {{ scope_dir }}端{{ display_name }}管理 - 表格列、搜索配置、表单 Schema
 */
import type { VbenFormSchema } from '#/adapter/form';
import type { OnActionClickFn, VxeTableGridOptions } from '#/adapter/vxe-table';
import type { {{ model_class }}Item } from '#/api/{{ scope_dir }}/{{ module }}s';

import {
{% set ns = namespace(need_input=false, need_number=false, need_select=false, need_textarea=false, need_switch=false, need_date=false, need_search_input=false, need_status_select=false) %}
{% for field in fields %}
{% if field.in_form %}
{% if field.form_component.value == 'Input' %}{% set ns.need_input = true %}{% endif %}
{% if field.form_component.value == 'InputNumber' %}{% set ns.need_number = true %}{% endif %}
{% if field.form_component.value == 'Select' or field.type.value == 'enum' %}{% set ns.need_select = true %}{% endif %}
{% if field.form_component.value == 'Textarea' %}{% set ns.need_textarea = true %}{% endif %}
{% if field.form_component.value == 'Switch' or field.type.value == 'boolean' %}{% set ns.need_switch = true %}{% endif %}
{% if field.form_component.value in ('DatePicker', 'RangePicker') or field.type.value in ('date', 'datetime') %}{% set ns.need_date = true %}{% endif %}
{% endif %}
{% if field.searchable %}{% set ns.need_search_input = true %}{% endif %}
{% endfor %}
{% if has_status_toggle %}{% set ns.need_switch = true %}{% endif %}
{% if ns.need_input %}
  inputField,
{% endif %}
{% if ns.need_number %}
  numberField,
{% endif %}
{% if ns.need_select %}
  select,
{% endif %}
{% if ns.need_textarea %}
  textareaField,
{% endif %}
{% if ns.need_switch %}
  switchField,
{% endif %}
{% if ns.need_date %}
  dateField,
{% endif %}
{% if ns.need_search_input %}
  searchInput,
{% endif %}
{% for field in fields %}
{% if field.searchable and field.type.value == 'enum' %}
{% set ns.need_status_select = true %}
{% endif %}
{% endfor %}
{% if ns.need_status_select %}
  statusSelect,
{% endif %}
} from '#/adapter/form';
import { $t } from '#/locales';
{% for enum in enums %}

// ============ {{ enum.name }} 辅助 ============

export function get{{ enum.name }}Options() {
  return [
{% for opt in enum.values %}
    { label: $t('{{ i18n_prefix }}.enum.{{ enum.name | snake }}.{{ opt.value }}'), value: '{{ opt.value }}' },
{% endfor %}
  ];
}

export function get{{ enum.name }}Text(value: string | undefined): string {
  if (!value) return '-';
  return $t(`{{ i18n_prefix }}.enum.{{ enum.name | snake }}.${value}`);
}

export function get{{ enum.name }}Color(value: string | undefined): string {
  switch (value) {
{% for opt in enum.values %}
    case '{{ opt.value }}': return '{{ opt.color or 'default' }}';
{% endfor %}
    default: return 'default';
  }
}
{% endfor %}

// ============ 表格列 ============

export function useColumns<T = {{ model_class }}Item>(
  onActionClick: OnActionClickFn<T>,
): VxeTableGridOptions['columns'] {
  return [
{% for field in fields %}
{% if field.in_list %}
    {
      field: '{{ field.name }}',
      title: $t('{{ i18n_prefix }}.field.{{ field.name }}'),
{% if field.list_width %}
      width: {{ field.list_width }},
{% else %}
      minWidth: 150,
{% endif %}
{% if field.list_align != 'left' %}
      align: '{{ field.list_align }}',
{% endif %}
{% if field.list_sortable or field.sortable %}
      sortable: true,
{% endif %}
{% if field.list_fixed %}
      fixed: '{{ field.list_fixed }}',
{% endif %}
{% if field.list_render and field.list_render.value in ('tag', 'switch') %}
      slots: { default: '{{ field.name }}_cell' },
{% elif field.list_slot %}
      slots: { default: '{{ field.list_slot }}' },
{% endif %}
    },
{% endif %}
{% endfor %}
{% if has_status_toggle %}
    {
      field: 'is_active',
      title: $t('{{ i18n_prefix }}.field.isActive'),
      width: 100,
      align: 'center',
      slots: { default: 'is_active_cell' },
    },
{% endif %}
    {
      field: 'created_at',
      title: $t('{{ scope_dir }}.common.createdAt'),
      width: 170,
      sortable: true,
    },
    {
      align: 'center',
      cellRender: {
        attrs: {
          resource: '{{ module_snake }}',
          nameField: '{{ fields[0].name if fields else 'name' }}',
          nameTitle: $t('{{ i18n_prefix }}.field.{{ fields[0].name if fields else 'name' }}'),
          onClick: onActionClick,
        },
        name: 'CellOperation',
        options: [{{ "'edit', 'delete'" }}],
      },
      field: 'operation',
      fixed: 'right',
      title: $t('{{ scope_dir }}.common.operation'),
      width: 180,
    },
  ];
}

// ============ 搜索表单 ============

export function useGridFormSchema(): VbenFormSchema[] {
  return [
{% if search_config and search_config.fields %}
{% for sf in search_config.fields %}
{% if sf.component.value == 'Input' %}
    searchInput('{{ sf.field }}', $t('{{ i18n_prefix }}.field.{{ sf.field }}'){% if sf.placeholder_zh %}, {
      placeholder: $t('{{ i18n_prefix }}.search.{{ sf.field }}'),
    }{% endif %}),
{% elif sf.component.value == 'Select' %}
    statusSelect('{{ sf.field }}', $t('{{ i18n_prefix }}.field.{{ sf.field }}'), {
{% if sf.options_enum %}
      options: get{{ sf.options_enum }}Options(),
{% endif %}
    }),
{% elif sf.component.value == 'RangePicker' %}
    dateField('{{ sf.field }}', $t('{{ i18n_prefix }}.field.{{ sf.field }}')),
{% else %}
    searchInput('{{ sf.field }}', $t('{{ i18n_prefix }}.field.{{ sf.field }}')),
{% endif %}
{% endfor %}
{% else %}
{% for field in fields %}
{% if field.searchable %}
{% if field.type.value == 'enum' %}
    statusSelect('{{ field.name }}', $t('{{ i18n_prefix }}.field.{{ field.name }}'), {
{% if field.enum_ref %}
      options: get{{ field.enum_ref }}Options(),
{% endif %}
    }),
{% else %}
    searchInput('{{ field.name }}', $t('{{ i18n_prefix }}.field.{{ field.name }}')),
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
  ];
}

// ============ 编辑表单 ============

export function useFormSchema(): VbenFormSchema[] {
  return [
{% for field in fields %}
{% if field.in_form %}
{% if field.type.value in ('string',) and field.form_component.value == 'Input' %}
    inputField('{{ field.name }}', $t('{{ i18n_prefix }}.field.{{ field.name }}'), {
{% if field.required %}
      required: true,
{% endif %}
{% if field.max_length %}
      maxLength: {{ field.max_length }},
{% endif %}
    }),
{% elif field.type.value == 'text' or field.form_component.value == 'Textarea' %}
    textareaField('{{ field.name }}', $t('{{ i18n_prefix }}.field.{{ field.name }}'), {
      rows: 3,
{% if field.required %}
      required: true,
{% endif %}
    }),
{% elif field.type.value in ('integer', 'float', 'decimal') or field.form_component.value == 'InputNumber' %}
    numberField('{{ field.name }}', $t('{{ i18n_prefix }}.field.{{ field.name }}'), {
{% if field.required %}
      required: true,
{% endif %}
    }),
{% elif field.type.value == 'enum' or field.form_component.value == 'Select' %}
    select('{{ field.name }}', $t('{{ i18n_prefix }}.field.{{ field.name }}'), {
{% if field.enum_ref %}
      options: get{{ field.enum_ref }}Options(),
{% endif %}
{% if field.required %}
      required: true,
{% endif %}
    }),
{% elif field.type.value == 'boolean' or field.form_component.value == 'Switch' %}
    switchField('{{ field.name }}', $t('{{ i18n_prefix }}.field.{{ field.name }}')),
{% elif field.type.value in ('date', 'datetime') or field.form_component.value in ('DatePicker', 'RangePicker') %}
    dateField('{{ field.name }}', $t('{{ i18n_prefix }}.field.{{ field.name }}')),
{% else %}
    inputField('{{ field.name }}', $t('{{ i18n_prefix }}.field.{{ field.name }}')),
{% endif %}
{% endif %}
{% endfor %}
{% if has_status_toggle %}
    switchField('is_active', $t('{{ i18n_prefix }}.field.isActive')),
{% endif %}
  ];
}
