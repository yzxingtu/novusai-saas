{# ============================================================
   Jinja2 Template: 前端卡片布局列表页 index_card.vue.j2
   生成路径: views/{{ scope_dir }}/{{ parent_menu }}/{{ module }}s/index.vue
   LayoutVariant = card

   变量: 同 index.vue.j2
   ============================================================ #}
{% raw %}<script lang="ts" setup>{% endraw %}

/**
 * {{ scope_dir }}端{{ display_name }}管理 — 卡片布局
 */
import type { {{ model_class }}Item } from '#/api/{{ scope_dir }}/{{ module }}s';

defineOptions({ name: '{{ scope_dir | capitalize }}{{ model_class }}CardList' });

import { ref, onMounted } from 'vue';

import { Page } from '@vben/common-ui';
import { Plus } from '@vben/icons';

import {
  Button,
  Card,
  Col,
  Empty,
  Input,
  Pagination,
  Row,
  Spin,
{% set ns = namespace(has_tag=false) %}
{% for field in fields %}
{% if field.list_render and field.list_render.value == 'tag' %}{% set ns.has_tag = true %}{% endif %}
{% endfor %}
{% if ns.has_tag %}
  Tag,
{% endif %}
} from 'ant-design-vue';

import { useCrudPage } from '#/adapter/vxe-table';
import {
  delete{{ model_class }}Api,
  get{{ model_class }}ListApi,
} from '#/api/{{ scope_dir }}/{{ module }}s';
import { $t } from '#/locales';
{% for enum in enums %}
{% for field in fields %}
{% if field.enum_ref == enum.name and field.in_list and field.list_render and field.list_render.value == 'tag' %}

import { get{{ enum.name }}Color, get{{ enum.name }}Text } from './data';
{% endif %}
{% endfor %}
{% endfor %}
import { columns } from './data';
import {{ model_class }}Form from './modules/form.vue';

const { FormDrawer, onCreate, onEdit, onDelete } = useCrudPage<{{ model_class }}Item>({
  api: {
    list: get{{ model_class }}ListApi,
    delete: delete{{ model_class }}Api,
  },
  formComponent: {{ model_class }}Form,
  columns,
  onSuccess: fetchData,
});

const loading = ref(false);
const items = ref<{{ model_class }}Item[]>([]);
const total = ref(0);
const page = ref(1);
const pageSize = ref(12);
const keyword = ref('');

async function fetchData() {
  loading.value = true;
  try {
    const params: Record<string, unknown> = {
      'page[number]': page.value,
      'page[size]': pageSize.value,
      sort: '{{ config.list_config.default_sort }}',
    };
    if (keyword.value) {
      params['filter[{{ fields[0].name if fields else 'name' }}][ilike]'] = keyword.value;
    }
    const res = await get{{ model_class }}ListApi(params);
    items.value = res.items;
    total.value = res.total;
  } finally {
    loading.value = false;
  }
}

function onPageChange(p: number) {
  page.value = p;
  fetchData();
}

function onSearch() {
  page.value = 1;
  fetchData();
}

onMounted(() => fetchData());
{% raw %}</script>{% endraw %}

{% raw %}<template>{% endraw %}

  <Page auto-content-height content-class="flex flex-col gap-4">
    <FormDrawer />

    <div class="mb-4 flex items-center justify-between">
      <Input.Search
        v-model:value="keyword"
        :placeholder="$t('{{ i18n_prefix }}.search')"
        style="width: 300px"
        allow-clear
        @search="onSearch"
      />
      <Button
        type="primary"
        v-access:code="['{{ module_snake }}:create']"
        @click="onCreate"
      >
        <Plus class="mr-1 size-4" />
        {% raw %}{{ {% endraw %}$t('{{ i18n_prefix }}.create'){% raw %} }}{% endraw %}

      </Button>
    </div>

    <Spin :spinning="loading">
      <Empty v-if="!loading && items.length === 0" />
      <Row v-else :gutter="[16, 16]">
        <Col v-for="item in items" :key="item.id" :xs="24" :sm="12" :md="8" :lg="6">
          <Card hoverable class="h-full" @click="onEdit(item)">
{% for field in fields %}
{% if field.in_list and loop.index <= 3 %}
{% if field.list_render and field.list_render.value == 'tag' and field.enum_ref %}
            <Tag :color="get{{ field.enum_ref }}Color(item.{{ field.name }})">
              {% raw %}{{ {% endraw %}get{{ field.enum_ref }}Text(item.{{ field.name }}){% raw %} }}{% endraw %}

            </Tag>
{% elif loop.index == 1 %}
            <template #title>
              <span class="text-sm font-medium">{% raw %}{{ {% endraw %}item.{{ field.name }}{% raw %} }}{% endraw %}</span>
            </template>
{% else %}
            <p class="text-xs text-muted-foreground">{% raw %}{{ {% endraw %}item.{{ field.name }} || '-'{% raw %} }}{% endraw %}</p>
{% endif %}
{% endif %}
{% endfor %}
          </Card>
        </Col>
      </Row>

      <div v-if="total > pageSize" class="mt-4 flex justify-end">
        <Pagination
          :current="page"
          :page-size="pageSize"
          :total="total"
          show-size-changer
          @change="onPageChange"
        />
      </div>
    </Spin>
  </Page>
{% raw %}</template>{% endraw %}
