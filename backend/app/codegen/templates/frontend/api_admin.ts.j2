{% if model.drag_sort | default(false) %}
/** Reorder / 重新排序 */
export async function reorder{{ resource | pascal }}sApi(
  ids: number[],
  options?: ApiRequestOptions,
): Promise<void> {
  await requestClient.put(`${API_PREFIX}/reorder`, { ids }, options);
}

{% endif %}
{% if batch and batch.get('import') %}
/** Import from Excel / 从 Excel 导入 */
export async function import{{ resource | pascal }}Api(
  file: File,
  options?: ApiRequestOptions,
): Promise<{ data: { imported: number; errors?: string[] } }> {
  const formData = new FormData();
  formData.append('file', file);
  return requestClient.post<{ data: { imported: number; errors?: string[] } }>(
    `${API_PREFIX}/import`,
    formData,
    {
      ...options,
      headers: {
        ...(options?.headers as Record<string, string>),
        'Content-Type': undefined,
      },
    },
  );
}

{% endif %}
{% if model.tree is defined and model.tree is mapping and model.tree.get('enabled') %}
/** Get tree / 获取树形数据 */
export async function get{{ resource | pascal }}TreeApi(
  params?: { parent_id?: number },
  options?: ApiRequestOptions,
): Promise<{{ resource | pascal }}Info[]> {
  const raw = await requestClient.get<{{ resource | pascal }}InfoRaw[]>(`${API_PREFIX}/tree`, {
    params: params || {},
    ...options,
  });
  return Array.isArray(raw) ? raw.map((item) => transform{{ resource | pascal }}(item)) : [];
}

{% endif %}
