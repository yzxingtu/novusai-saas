/**
 * {{ display_name }} Admin API / {{ display_name_en }} Admin API
 * Backend: /admin/{{ route_prefix | default(resource_plural) }}
 */
import type { ApiRequestOptions } from '#/utils/request';

import { requestClient } from '#/utils/request';

// ============================================================
// Type definitions / 类型定义
// ============================================================
{% include 'frontend/_api_types.j2' %}

// ============================================================
// API functions / API 接口
// ============================================================

{% set api_path = admin_ep.get('route_prefix') | default('/' + resource_plural) | replace('/','') %}
const API_PREFIX = '/admin/{{ api_path or resource_plural }}';

/** Get list / 获取列表 */
export async function get{{ resource | pascal }}ListApi(
  params?: {{ resource | pascal }}ListParams,
  options?: ApiRequestOptions,
): Promise<{{ resource | pascal }}ListResponse> {
  const response = await requestClient.get<{
    items: {{ resource | pascal }}InfoRaw[];
    page: number;
    page_size: number;
    total: number;
  }>(API_PREFIX, { params, ...options });

  return {
    items: response.items.map((item) => transform{{ resource | pascal }}(item)),
    page: response.page,
    page_size: response.page_size,
    total: response.total,
  };
}

/** Get detail / 获取详情 */
export async function get{{ resource | pascal }}DetailApi(
  id: number,
  options?: ApiRequestOptions,
): Promise<{{ resource | pascal }}Info> {
  const raw = await requestClient.get<{{ resource | pascal }}InfoRaw>(
    `${API_PREFIX}/${id}`,
    options,
  );
  return transform{{ resource | pascal }}(raw);
}

/** Create / 创建 */
export async function create{{ resource | pascal }}Api(
  data: {{ resource | pascal }}CreateRequest,
  options?: ApiRequestOptions,
): Promise<{{ resource | pascal }}Info> {
  const raw = await requestClient.post<{{ resource | pascal }}InfoRaw>(
    API_PREFIX,
    data,
    options,
  );
  return transform{{ resource | pascal }}(raw);
}

/** Update / 更新 */
export async function update{{ resource | pascal }}Api(
  id: number,
  data: {{ resource | pascal }}UpdateRequest,
  options?: ApiRequestOptions,
): Promise<{{ resource | pascal }}Info> {
  const raw = await requestClient.put<{{ resource | pascal }}InfoRaw>(
    `${API_PREFIX}/${id}`,
    data,
    options,
  );
  return transform{{ resource | pascal }}(raw);
}

/** Delete / 删除 */
export async function delete{{ resource | pascal }}Api(
  id: number,
  options?: ApiRequestOptions,
): Promise<void> {
  await requestClient.delete(`${API_PREFIX}/${id}`, options);
}

{% if model.selectable is defined and model.selectable %}
/** Get select options / 获取下拉选项 */
export async function get{{ resource | pascal }}SelectApi(params?: {
  is_active?: string;
  page?: number;
  page_size?: number;
  search?: string;
}): Promise<{{ resource | pascal }}SelectResponse> {
  return requestClient.get<{{ resource | pascal }}SelectResponse>(`${API_PREFIX}/select`, {
    params,
  });
}

{% endif %}
