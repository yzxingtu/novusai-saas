backend/plugins/.backups/
backend/plugins/.versions/
backend/plugins/*.zip

# SageMath parsed files
*.sage.py

# Environments
.env
.env.local
.env.*.local
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

