# ============================================
# NovusAI SaaS - Monorepo .gitignore
# ============================================

# ============================================
# Python / Backend
# ============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
!frontend/apps/web-antd/build/
frontend/apps/web-antd/build/*
!frontend/apps/web-antd/build/vite-plugin-novus-plugins.ts
!frontend/apps/web-antd/build/vite-plugin-novus-plugins.d.ts
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Ruff full report (local artifact; do not commit)
backend/ruff_full_report.txt

# Codegen rollback manifest (generated at runtime)
/codegen_manifest.json

# Private production environment file copied from production.env.example
/production.env

# Local AI, agent, IDE, and repository workflow configs
/.agent/
/.agents/
/.claude/
/.codex/
/.cursor/
/.cursorrules
/.qoder/*
!/.qoder/repowiki/
!/.qoder/repowiki/**
!/.qoder/rules/
/AGENTS.md

# The website is developed as a separate repository checked out locally here.
/website/

