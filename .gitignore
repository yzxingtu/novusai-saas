.pytest-tmp/
pytest_cache/
test-results/
playwright-report/
.playwright/

# Translations
*.mo
*.pot

# Celery stuff
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid
backend/var/celerybeat/

