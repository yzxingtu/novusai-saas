VITE_BASE=/
VITE_APP_TITLE=NovusAI SaaS

# 接口地址（生产环境，部署时替换为实际域名）
VITE_GLOB_API_URL=https://api.novusai.example.com

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 平台管理端域名（逗号分隔，用于域名检测快速匹配）
VITE_PLATFORM_DOMAINS=

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
