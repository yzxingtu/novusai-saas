# 端口号
VITE_PORT=5666

VITE_BASE=/
VITE_APP_TITLE=NovusAI SaaS

# 接口地址
# 使用 IPv4 loopback 作为开发基址，避免 localhost 在 Chrome 中优先解析到
# 被其他 Docker/WSL 服务占用的 IPv6 ::1:8000。
VITE_GLOB_API_URL=http://127.0.0.1:8000


# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 平台管理端域名（逗号分隔，用于域名检测快速匹配）
VITE_PLATFORM_DOMAINS=localhost,127.0.0.1,192.168.31.129

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
