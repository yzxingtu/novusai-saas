# NovusAI SaaS 生产环境变量示例
#
# 使用前请复制为 production.env，并根据实际部署环境修改每一个值。
# production.env 包含真实密钥和生产配置，已在 .gitignore 中排除，请勿提交到 Git。
# 使用 docker-compose.prod.yml 时，建议通过 --env-file 传入同一个文件，
# 这样 Compose 变量插值和容器 env_file 都能读取到这些变量：
#
#   cp production.env.example production.env
#   docker compose --env-file production.env -f docker-compose.prod.yml up -d

# docker-compose.prod.yml 读取的私有生产环境变量文件路径。
# 通常保持为 ./production.env，并与 --env-file 传入的文件一致。
NOVUSAI_PROD_ENV_FILE=./production.env

# 后端、Worker、Beat、前端镜像共用的不可变版本标签。
# 生产环境建议使用 v1.0.0 这类发布标签，不建议使用 latest。
NOVUSAI_IMAGE_TAG=v1.0.0

# backend-api 容器 8000 端口映射到宿主机的端口。
# Compose 默认只绑定 127.0.0.1，建议通过反向代理对外暴露。
BACKEND_HTTP_PORT=18000

# frontend 容器 8080 端口映射到宿主机的端口。
# Compose 默认只绑定 127.0.0.1，建议通过反向代理对外暴露。
FRONTEND_HTTP_PORT=18080

# 应用显示名称。
APP_NAME=NovusAI SaaS

# 后端展示或记录使用的应用版本。
APP_VERSION=0.1.0

# 运行环境。生产 Compose 也会在后端容器中强制设置为 production。
APP_ENV=production

# 是否启用调试模式。
# 生产环境应保持 false。
DEBUG=false

# API 进程启动时是否自动执行数据库迁移。
# 生产 Compose 使用 backend-migrate 服务执行迁移，因此这里保持 false。
RUN_MIGRATIONS_ON_STARTUP=false

# 后端业务逻辑和数据库时间处理使用的时区。
TIMEZONE=UTC

# API v1 路由前缀。
API_V1_PREFIX=/api/v1

# 后端内部访问基础地址，用于 Worker 或服务间调用。
# 生产 Compose 会在后端容器中覆盖为 http://backend-api:8000。
APP_INTERNAL_BASE_URL=http://backend-api:8000

# 允许浏览器调用后端 API 的前端来源。
# 支持 JSON 数组或逗号分隔格式，按后端配置解析规则填写。
CORS_ORIGINS=["https://app.example.com"]

# 后端签名密钥，用于 JWT 和其他安全敏感逻辑。
# 请生成高强度随机值，例如：openssl rand -hex 32
SECRET_KEY=replace-with-a-strong-secret-key

# Access Token 有效期，单位：分钟。
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Refresh Token 有效期，单位：天。
REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT 签名算法。
ALGORITHM=HS256

# 后端容器访问 PostgreSQL 的主机名。
# 生产 Compose 会在后端容器中覆盖为 postgres。
DATABASE_HOST=postgres

# 后端容器访问 PostgreSQL 的端口。
# 生产 Compose 会在后端容器中覆盖为 5432。
DATABASE_PORT=5432

# PostgreSQL 用户名。
DATABASE_USER=novusai

# PostgreSQL 密码。
DATABASE_PASSWORD=replace-with-a-strong-database-password

# PostgreSQL 数据库名。
DATABASE_NAME=novusai_saas

# 每个后端进程的 SQLAlchemy 连接池基础连接数。
DATABASE_POOL_SIZE=10

# 超出基础连接池后允许额外打开的连接数。
DATABASE_MAX_OVERFLOW=20

# 获取数据库连接的等待超时时间，单位：秒。
DATABASE_POOL_TIMEOUT=30

# 后端容器访问 Redis 的主机名。
# 生产 Compose 会在后端容器中覆盖为 redis。
REDIS_HOST=redis

# 后端容器访问 Redis 的端口。
# 生产 Compose 会在后端容器中覆盖为 6379。
REDIS_PORT=6379

# Redis 密码，同时供 redis 服务和后端客户端使用。
REDIS_PASSWORD=replace-with-a-strong-redis-password

# 后端使用的 Redis 逻辑数据库编号。
REDIS_DB=0

# Celery Broker URL。
# 留空时后端会根据 Redis 配置自动拼接。
CELERY_BROKER_URL=

# Celery Result Backend URL。
# 留空时后端会根据 Redis 配置自动拼接。
CELERY_RESULT_BACKEND=

# 后端日志级别。
LOG_LEVEL=INFO

# Python 日志格式。
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 后端容器内日志目录。
LOG_DIR=logs

# 是否同时把数据库日志输出到控制台。
LOG_DB_TO_CONSOLE=false

# 是否压低 WebSocket 握手日志噪音。
LOG_QUIET_WEBSOCKET_HANDSHAKE=true

# 列表接口默认分页大小。
DEFAULT_PAGE_SIZE=20

# 列表接口允许的最大分页大小。
MAX_PAGE_SIZE=100

# Celery Worker 并发数。
CELERY_WORKER_CONCURRENCY=4

# Celery 任务预取倍数。
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# Celery 任务软超时时间，单位：秒。
CELERY_TASK_SOFT_TIME_LIMIT=300

# Celery 任务硬超时时间，单位：秒。
CELERY_TASK_TIME_LIMIT=600

# 是否记录 Celery 任务 started 状态。
CELERY_TASK_TRACK_STARTED=true

# Celery 任务序列化格式。
CELERY_TASK_SERIALIZER=json

# Celery 结果序列化格式。
CELERY_RESULT_SERIALIZER=json

# Celery 允许接收的内容类型。
CELERY_ACCEPT_CONTENT=["json"]

# 通用 AI 缓存有效期，单位：秒。
AI_CACHE_TTL=3600

# 平台域名列表，用于区分平台域名和租户域名。
# 只填写主机名，不包含协议和端口。
PLATFORM_DOMAINS=app.example.com

# 是否启用租户自定义域名。
ALLOW_CUSTOM_DOMAIN=false

# 启用租户子域名时使用的默认域名后缀。
TENANT_DOMAIN_SUFFIX=.tenant.example.com

# 租户域名归属校验使用的 DNS 记录前缀。
DOMAIN_VERIFICATION_PREFIX=_novusai-verify

# SSL 证书到期前多少天开始尝试自动续期。
SSL_AUTO_RENEW_DAYS=30

# 用于加密保存 SSL 私钥的 Fernet key。
# 如果启用自定义域名和证书私钥存储，请填写此项。
SSL_PRIVATE_KEY_ENCRYPTION_KEY=

# ACME 是否使用测试环境。
# 真实生产证书应设置为 false。
ACME_USE_STAGING=false

# ACME 生产环境目录地址。
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory

# ACME 测试环境目录地址。
ACME_STAGING_URL=https://acme-staging-v02.api.letsencrypt.org/directory

# ACME 账号邮箱，用于注册和接收证书通知。
ACME_ACCOUNT_EMAIL=ops@example.com

# 插件注册中心地址。
# 留空时使用框架默认的注册中心行为。
PLUGIN_REGISTRY_URL=

# 插件注册中心镜像来源。
PLUGIN_REGISTRY_MIRROR=github

# 插件注册中心缓存时间，单位：秒。
PLUGIN_REGISTRY_CACHE_TTL=3600

# 可选 GitHub Token，用于访问私有注册中心或提升请求额度。
GITHUB_TOKEN=

# 可选 GitHub 代理地址。
GITHUB_PROXY=

# 可选 Gitee Token。
GITEE_TOKEN=

# 插件压缩包最大体积，单位：字节。
PLUGIN_MAX_PACKAGE_SIZE=52428800

# 插件解压后允许的最大总体积，单位：字节。
PLUGIN_MAX_UNCOMPRESSED_SIZE=209715200

# 插件压缩包允许包含的最大文件数量。
PLUGIN_MAX_ARCHIVE_FILES=2000

# 插件压缩包内单个文件允许的最大体积，单位：字节。
PLUGIN_MAX_ARCHIVE_SINGLE_FILE_SIZE=52428800

# 插件压缩包安全检查允许的最大压缩比。
PLUGIN_MAX_COMPRESSION_RATIO=100

# 是否只为已启用插件提供静态资源访问。
PLUGIN_ASSETS_ENABLED_ONLY=true

# 模块级回收站记录保留天数。
RECYCLE_BIN_MODULE_RETENTION_DAYS=30

# 全局回收站记录保留天数。
RECYCLE_BIN_GLOBAL_RETENTION_DAYS=30

# 构建生产前端镜像时使用的后端 API 地址。
# 已构建完成的 Vite 镜像不会在运行时重新注入这些变量；
# 请在构建前端产物时使用此配置。
FRONTEND_VITE_GLOB_API_URL=https://api.example.com

# 构建生产前端镜像时使用的平台域名列表。
FRONTEND_VITE_PLATFORM_DOMAINS=app.example.com

# 构建生产前端镜像时使用的前端安全存储密钥。
FRONTEND_VITE_APP_STORE_SECURE_KEY=replace-with-a-strong-frontend-storage-key
